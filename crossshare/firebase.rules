rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Auth helpers ----
    function signedIn() {
      return request.auth != null;
    }

    // The founding superadmin — always admin by email token
    function isSuperAdminEmail() {
      return signedIn() && request.auth.token.email == 'joelmulonde81@gmail.com';
    }

    // Any user whose UID is in the xmen_admins collection
    function isAdmin() {
      return signedIn() && (
        isSuperAdminEmail() ||
        exists(/databases/$(database)/documents/xmen_admins/$(request.auth.uid))
      );
    }

    function changedKeysOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isCommcalOwnerDoc(cc) {
      return signedIn() && (
        cc.ownerId == request.auth.uid
        || (request.auth.token.email != null
            && 'ownerEmails' in cc
            && request.auth.token.email in cc.ownerEmails)
      );
    }

    function isCommcalOwner(commcalId) {
      return isCommcalOwnerDoc(
        get(/databases/$(database)/documents/commcals/$(commcalId)).data
      );
    }

    // ---- XMEN Admin registry ----
    // Only the superadmin email can write. All admins can read.
    match /xmen_admins/{uid} {
      allow read:   if isAdmin();
      allow create: if isSuperAdminEmail();
      allow update: if isSuperAdminEmail();
      allow delete: if isSuperAdminEmail();
    }

    // ---- XMEN config (auto-boost etc.) ----
    match /xmen_config/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- XMEN Audit log ----
    // Any admin can read/create. Nobody can edit or delete entries.
    match /xmen_audit_log/{logId} {
      allow read:          if isAdmin();
      allow create:        if isAdmin();
      allow update, delete: if false;
    }

    // ---- Collection-group query for events ----
    // Authorises collectionGroup("events") reads used by the main app
    // and the admin panel. Writes are governed by per-commcal rules below.
    match /{path=**}/events/{eventId} {
      allow read: if true;
    }

    // ---- User profiles & preferences ----
    // Users read/write their own doc; admins can read/write any user doc.
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ---- Official, app-managed data ----
    // Public read; only admins can write (previously client write was blocked).
    match /deadlines/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /meta/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /community/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- Crossshare projects ----
    // Owners manage full project docs. Members (by email) can read/edit content.
    // Public viewers may read a project when it has a non-expired projectCode
    // (used by the standalone viewer).
    function isCrossshareOwner() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function isCrossshareOwnerCreate() {
      return signedIn()
        && request.resource.data.ownerId == request.auth.uid;
    }

    function crossshareAuthEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isCrossshareMember() {
      return signedIn()
        && request.auth.token.email is string
        && 'memberEmails' in resource.data
        && resource.data.memberEmails is list
        && crossshareAuthEmail() in resource.data.memberEmails;
    }

    function crossshareCodeValid() {
      return resource.data.projectCode is string
        && resource.data.projectCode.size() > 0
        && (
          !('projectCodeExpiryMode' in resource.data)
          || resource.data.projectCodeExpiryMode == 'never'
          || !('projectCodeExpiresAt' in resource.data)
          || resource.data.projectCodeExpiresAt == null
          || resource.data.projectCodeExpiresAt > request.time.toMillis()
        );
    }

    function crossshareTempCodeValid() {
      return resource.data.tempCode is string
        && resource.data.tempCode.size() == 4
        && resource.data.tempCodeExpiresAt is number
        && resource.data.tempCodeExpiresAt > request.time.toMillis();
    }

    function crossshareOwnerFieldsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerEmail == resource.data.ownerEmail;
    }

    function crossshareMembersUnchanged() {
      return (
        (
          !('members' in resource.data) && !('members' in request.resource.data)
        )
        || request.resource.data.members == resource.data.members
      )
      && (
        (
          !('memberEmails' in resource.data) && !('memberEmails' in request.resource.data)
        )
        || request.resource.data.memberEmails == resource.data.memberEmails
      );
    }

    match /crossshare_projects/{projectId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isCrossshareMember()
        || crossshareCodeValid()
        || crossshareTempCodeValid();

      // Queries can only be authorized by fields the query itself constrains,
      // so expiry is enforced client-side and on subsequent gets.
      allow list: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isCrossshareMember()
        || request.query.limit <= 1;

      allow create: if isCrossshareOwnerCreate()
        && request.resource.data.id == projectId
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'created']);

      allow update: if isAdmin()
        || (
          isCrossshareOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.id == projectId
        )
        || (
          isCrossshareMember()
          && crossshareOwnerFieldsUnchanged()
          && crossshareMembersUnchanged()
          && request.resource.data.id == projectId
        );

      allow delete: if isAdmin() || isCrossshareOwner();
    }

    // ---- Crossboard sessions ----
    // Owners create/manage boards. Signed-in users may look up a session by
    // active code and read public sessions. Viewers may only bump viewers count.
    function isCrossboardOwner() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function isCrossboardOwnerCreate() {
      return signedIn()
        && request.resource.data.ownerId == request.auth.uid;
    }

    function crossboardCodeValid() {
      return resource.data.code is string
        && resource.data.code.size() == 4
        && resource.data.codeExpiresAt is number
        && resource.data.codeExpiresAt > request.time.toMillis();
    }

    function crossboardSessionData(sessionId) {
      return get(/databases/$(database)/documents/crossboard_sessions/$(sessionId)).data;
    }

    function canReadCrossboardSession(sessionId) {
      return isAdmin()
        || (signedIn() && crossboardSessionData(sessionId).ownerId == request.auth.uid)
        || (signedIn() && crossboardSessionData(sessionId).isPublic == true);
    }

    function isCrossboardSessionOwner(sessionId) {
      return signedIn()
        && crossboardSessionData(sessionId).ownerId == request.auth.uid;
    }

    match /crossboard_sessions/{sessionId} {
      allow get: if isAdmin()
        || isCrossboardOwner()
        || (signedIn() && resource.data.isPublic == true && crossboardCodeValid())
        || (signedIn() && resource.data.isPublic == true);

      allow list: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && request.query.limit <= 1);

      allow create: if isCrossboardOwnerCreate()
        && request.resource.data.id == sessionId
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'code', 'createdAt', 'isPublic']);

      allow update: if isAdmin()
        || (
          isCrossboardOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.id == sessionId
        )
        || (
          signedIn()
          && resource.data.isPublic == true
          && changedKeysOnly(['viewers'])
          && request.resource.data.viewers is number
        );

      allow delete: if isAdmin() || isCrossboardOwner();

      match /slides/{slideId}/strokes/{strokeId} {
        allow read: if canReadCrossboardSession(sessionId);
        allow create, update, delete: if isCrossboardSessionOwner(sessionId);
      }
    }

    // ---- Crossshare viewer presence ----
    // Viewers (possibly signed out) heartbeat while a project link is open.
    // Docs are keyed projectId__instanceId; content is limited to harmless
    // device/stream labels so open writes are acceptable.
    match /crossshare_presence/{presenceId} {
      function presenceDataValid() {
        return request.resource.data.keys().hasOnly([
            'projectId', 'instanceId', 'device', 'mode',
            'streamId', 'streamViewId', 'streamName',
            'joinedAt', 'lastSeen'
          ])
          && request.resource.data.projectId is string
          && request.resource.data.projectId.size() > 0
          && request.resource.data.projectId.size() <= 120
          && request.resource.data.instanceId is string
          && request.resource.data.instanceId.size() > 0
          && request.resource.data.instanceId.size() <= 80
          && presenceId == request.resource.data.projectId + '__' + request.resource.data.instanceId
          && request.resource.data.lastSeen is number
          && (!('device' in request.resource.data) || (request.resource.data.device is string && request.resource.data.device.size() <= 120))
          && (!('streamName' in request.resource.data) || request.resource.data.streamName == null || (request.resource.data.streamName is string && request.resource.data.streamName.size() <= 160));
      }

      allow read: if true;
      allow create, update: if presenceDataValid();
      allow delete: if true;
    }

    // ---- Community calendars (commcals) ----
    match /commcals/{commcalId} {
      allow read: if true;

      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn() && (
        isCommcalOwnerDoc(resource.data)
        || changedKeysOnly(['subscribers', 'memberIds'])
        || isAdmin()
      );

      allow delete: if signedIn() && (
        isCommcalOwnerDoc(resource.data)
        || isAdmin()
      );

      // Events within a commcal
      match /events/{eventId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid;

        allow update: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || isCommcalOwner(commcalId)
          || changedKeysOnly(['likes', 'views', 'attending'])
          || isAdmin()
        );

        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || isCommcalOwner(commcalId)
          || isAdmin()
        );
      }
    }

    // ---- Techchat classroom chat ----
    function isTechchatAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'joel.mulonde@crpusd.org';
    }

    match /techchat_classes/{classId} {
      function techchatClassValid() {
        return request.resource.data.keys().hasOnly([
            'code', 'subject', 'teacher', 'room',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.code is string
          && request.resource.data.code.size() > 0
          && request.resource.data.code.size() <= 8
          && request.resource.data.subject is string
          && request.resource.data.subject.size() > 0
          && request.resource.data.subject.size() <= 48
          && request.resource.data.teacher is string
          && request.resource.data.teacher.size() > 0
          && request.resource.data.teacher.size() <= 48
          && request.resource.data.room is string
          && request.resource.data.room.size() > 0
          && request.resource.data.room.size() <= 12
          && request.resource.data.createdAt is number
          && request.resource.data.createdBy is string
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number)
          && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy is string)
          && classId.size() > 0
          && classId.size() <= 20
          && classId != 'campus';
      }

      allow read: if true;
      allow create, update: if isTechchatAdmin() && techchatClassValid();
      allow delete: if isTechchatAdmin();
    }

    match /techchat_presence/{uid} {
      function techchatPresenceValid() {
        return request.resource.data.keys().hasOnly([
            'uid', 'handle', 'full', 'initials', 'tone',
            'classId', 'channelId', 'typingIn', 'typingAt', 'beat'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.handle is string
          && request.resource.data.handle.size() > 0
          && request.resource.data.handle.size() <= 60
          && request.resource.data.full is string
          && request.resource.data.full.size() <= 60
          && request.resource.data.initials is string
          && request.resource.data.initials.size() <= 4
          && request.resource.data.classId is string
          && request.resource.data.classId.size() <= 20
          && request.resource.data.channelId is string
          && request.resource.data.channelId.size() <= 20
          && request.resource.data.beat is number;
      }

      allow read: if true;
      allow create, update: if techchatPresenceValid();
      allow delete: if true;
    }

    match /techchat_rooms/{classId}/channels/{channelId}/messages/{messageId} {
      function techchatMessageValid() {
        return request.resource.data.keys().hasOnly([
            'authorId', 'handle', 'initials', 'tone',
            'text', 'gif', 'createdAt', 'reactions'
          ])
          && request.resource.data.authorId is string
          && request.resource.data.authorId.size() > 0
          && request.resource.data.authorId.size() <= 80
          && request.resource.data.handle is string
          && request.resource.data.handle.size() > 0
          && request.resource.data.handle.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is number
          && (request.resource.data.gif == null || request.resource.data.gif is map)
          && (request.resource.data.text.size() > 0 || request.resource.data.gif != null)
          && classId.size() <= 20
          && channelId.size() <= 20;
      }

      allow read: if true;
      allow create: if techchatMessageValid();
      allow update: if changedKeysOnly(['reactions'])
        && request.resource.data.reactions is map;
      allow delete: if false;
    }
  }
}
